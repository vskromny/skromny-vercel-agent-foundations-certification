  "cards": [
    {
      "dot": "cyan",
      "title": "Storefront rendering",
      "items": [
        "Home is force-static with revalidate 60",
        "Product pages are SSG via generateStaticParams",
        "/search is dynamic because it reads searchParams",
        "Reads go through lib/api.ts with ISR tags"
      ]
    },
    {
      "dot": "emerald",
      "title": "Agent loop",
      "items": [
        "chatFlow runs a DurableAgent over the same tools and instructions as shoppingAgent",
        "Each tool body is a \"use step\", so tool results are checkpointed",
        "searchProducts and getProductDetails render as product cards in the sidebar"
      ]
    },
    {
      "dot": "violet",
      "title": "Durability and resume",
      "items": [
        "POST /api/chat returns the run id in x-workflow-run-id",
        "The client parks it in localStorage and reconnects via /api/chat/:id/stream",
        "returnFlow executes each step once and retries it independently"
      ]
    },
    {
      "dot": "rose",
      "title": "Secrets and access",
      "items": [
        "BYPASS_SECRET never leaves the server; lib/api.ts appends it per request",
        "The cart UUID lives in an httpOnly cart_token cookie",
        "proxy.ts redirects every /admin route without the admin cookie"
      ]
    },
    {
      "dot": "amber",
      "title": "Still a workshop stub",
      "items": [
        "POST /api/admin/chat returns 501",
        "lib/workflows/admin-chat-flow.ts is an empty placeholder",
        "components/admin-agent-chat.tsx still uses local useState, not useChat"
      ]
    }
  ]
